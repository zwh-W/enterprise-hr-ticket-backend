APP_NAME=enterprise-hr-ticket-backend
ENVIRONMENT=local
DEBUG=true

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_hr_ticket

# Docker 容器内运行 API 时使用 postgres；本机 Python 调试时改成 localhost。
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/enterprise_hr_ticket
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

INTERNAL_API_KEY=change-me-internal-api-key

REDIS_URL=redis://redis:6379/0

CONFIG_YAML_PATH=config.yaml
IDEMPOTENCY_KEY_TTL_HOURS=24

# Optional: used by examples/agent_backend_adapter.py when Agent project calls this backend.
HR_BACKEND_BASE_URL=http://localhost:8000
